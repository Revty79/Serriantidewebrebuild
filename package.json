{
  "name": "serriantidewebrebuild",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/local-db.mjs setup",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:browser": "node --env-file=.env.test.local --import tsx scripts/auth-browser.test.ts",
    "local:setup": "npm run db:setup && npm run db:test:migrate && npm run db:test:seed",
    "db:test:migrate": "drizzle-kit migrate --config=drizzle.test.config.ts",
    "db:test:seed": "node --env-file=.env.test.local --conditions=react-server --import tsx scripts/seed-local-accounts.ts"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "dotenv": "17.4.2",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "playwright-core": "1.62.1",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "type": "module"
}
