# Copy these settings into .env.local for your own database.
# Use the actual PostgreSQL host and port from pgAdmin; 5432 is only the usual default.
# Preserve the exact strebuild_dev spelling and URL-encode password special characters.
DATABASE_URL=postgresql://serrian_tide_app:replace_with_url_encoded_password@127.0.0.1:5432/strebuild_dev
BETTER_AUTH_URL=http://localhost:3010
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters

# Automated tests instead use the ignored .env.test.local generated by npm run db:setup.
